# AI wishes. Set at least one; without any, /api/wish returns the prewritten wish for each person.

# Preferred: the CBH Youth Online chat proxy (OpenAI-compatible). Key = CYO_AI_API from that project's server .env.
CYO_AI_API=
# CYO_AI_URL=https://chat-api.chuyenbienhoa.com/v1/chat/completions
# CYO_AI_MODEL=gemini-auto

# Backup: Claude, used when the proxy fails or CYO_AI_API is not set.
ANTHROPIC_API_KEY=
# WISH_MODEL=claude-opus-5-5
